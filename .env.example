# Скопируйте в .env и задайте свой пароль.
# .env НЕ коммитится в GitHub и переносится на сервер вручную.
POSTGRES_DB=furniture
POSTGRES_USER=furniture
POSTGRES_PASSWORD=change-me

# Подпись cookie-сессий. Сгенерируйте: openssl rand -hex 32
APP_SECRET=change-me-too
# 1 — только по HTTPS (на боевом домене); локально по HTTP — 0
COOKIE_SECURE=1

# Лимиты тяжёлых эндпоинтов, запросов в минуту на пользователя/IP.
# По умолчанию: solve 240, batch 120, validate/preflight 240,
# layout 300, normalize 60, PUT 180.
# RATE_SOLVE_PER_MIN=240
# RATE_BATCH_PER_MIN=120
# RATE_VALIDATE_PER_MIN=240
# RATE_LAYOUT_PER_MIN=300
# RATE_NORMALIZE_PER_MIN=60
# RATE_SAVE_PER_MIN=180

# Реквизиты в PDF КП (необязательно)
# QUOTE_COMPANY=Моя мебельная мастерская
# QUOTE_PHONE=+40 700 000 000
# QUOTE_EMAIL=hello@example.com
# QUOTE_SITE=example.com

# ИИ-чат (DeepSeek / любой OpenAI-совместимый API).
# Ключ только на сервере; в браузер не попадает.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-chat
# AI_MAX_TOKENS=2000
# RATE_AI_PER_MIN=30
#
# Чтение планов (PDF/PNG/DXF/SVG). PDF-текст, DXF и SVG работают без vision.
# Для картинок и сканов задайте vision-модель (OpenAI-совместимую).
# AI_VISION_MODEL=gpt-4o
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_API_KEY=sk-...
# AI_VISION_TIMEOUT=120
# RATE_PLAN_PER_MIN=30
