# Скопируйте в .env и задайте свой пароль.
# .env НЕ коммитится в GitHub и переносится на сервер вручную.
POSTGRES_DB=furniture
POSTGRES_USER=furniture
POSTGRES_PASSWORD=change-me

# Подпись cookie-сессий. Сгенерируйте: openssl rand -hex 32
APP_SECRET=change-me-too
# 1 — только по HTTPS (на боевом домене)
COOKIE_SECURE=0
