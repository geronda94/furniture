# зависимости и сборка
**/node_modules/
apps/web/dist/
**/__pycache__/
**/*.pyc
.venv/
venv/

# секреты и локальные настройки
.env
.env.*
!.env.example
*.key
*.pem
*.p12

# гостевые копии демо (создаются кнопкой «Посмотреть демо» и e2e)
projects/demo-[0-9]*/

# временное
.playwright-mcp/
tmp/
out/
*.log
.DS_Store

# крупные/производные артефакты Blender
*.blend1
projects/*/renders/
projects/*/video/
projects/*/previews/
projects/*/cards/
.auth/

# резервные дампы БД: полные — только локально; в git — обезличенный срез
backups/*
!backups/README.md
!backups/committed/
!backups/committed/**

# локальные БД/выгрузки стратегии
*.sqlite
